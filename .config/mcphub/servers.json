{
  "nativeMCPServers": {
    "neovim": {
      "disabled_tools": [
        "delete_item",
        "execute_command",
        "execute_lua",
        "find_files",
        "list_directory",
        "move_item",
        "read_file",
        "replace_in_file",
        "write_file"
      ]
    }
  },
  "mcpServers": {
    "memory": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory@2026.1.26"
      ],
      "command": "npx",
      "env": {
        "MEMORY_FILE_PATH": "/Users/shimehituzi/.config/mcphub/memory.json"
      }
    },
    "git": {
      "args": [
        "mcp-server-git==2026.1.14"
      ],
      "command": "uvx",
      "disabled": false
    },
    "github": {
      "args": [
        "-c",
        "GITHUB_PERSONAL_ACCESS_TOKEN=$(gopass show -o github/api_key) npx -y @modelcontextprotocol/server-github@2025.4.8"
      ],
      "command": "/bin/zsh",
      "disabled": false
    },
    "sequentialthinking": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking@2025.12.18"
      ],
      "command": "npx",
      "disabled": false
    },
    "time": {
      "args": [
        "mcp-server-time==2026.1.26",
        "--local-timezone=Asia/Tokyo"
      ],
      "command": "uvx",
      "disabled": false
    }
  }
}